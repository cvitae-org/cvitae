# Required only for the "Customize for job offer" feature (POST /api/cv/generate).
# The CV renders and exports to PDF without it.

# Optional. Where cvitae-scrapper is listening.
#
# Job research works without it: when nothing answers here, the research route
# falls back to its own fetch, which reads server-rendered boards only. Start
# the scraper (`pnpm dev` in ../cvitae-scrapper) and research also handles
# JavaScript-only boards, and fills company/salary/skills from the board's own
# listing data instead of inferring them.
#
# Defaults to http://127.0.0.1:8787. Set it to empty to skip the attempt.
# SCRAPER_URL=http://127.0.0.1:8787

# Optional. Where cvitae-agent-runtime is listening.
#
# The runtime owns the offer analysis: the provider credentials, the prompts and
# the store all live in that process rather than this one. Job research tries it
# first and falls back to cvitae's own in-process pipeline when nothing answers,
# so not starting it changes nothing. Start it (`pnpm dev` in
# ../cvitae-agent-runtime) and the analysis runs there instead — the row's note
# says which one produced it.
#
# Note that only silence causes the fallback. If the runtime answers and refuses
# — a missing credential, a step that failed — that is the answer, and cvitae
# reports it rather than quietly re-running the offer against a different model.
#
# Defaults to http://127.0.0.1:8788. Set it to empty to skip the attempt.
# RUNTIME_URL=http://127.0.0.1:8788

# Which AI provider to use: openrouter | huggingface | openai | local
# Defaults to "openrouter", which runs on a free-tier model.
# The Settings page (/settings) overrides this per-browser without a restart.
AI_PROVIDER=openrouter

# "local" needs no key — it calls an OpenAI-compatible server on your machine
# (Ollama :11434/v1, LM Studio :1234/v1, llama.cpp / vLLM :8080/v1). The URL is
# set in /settings and is restricted to localhost. Note that a local model can
# take longer than the route's 60s maxDuration, so it suits local use.

# Optional. Overrides the provider's default model.
#   openrouter   -> google/gemma-4-26b-a4b-it:free
#   huggingface  -> speakleash/Bielik-11B-v3.0-Instruct
#   openai       -> gpt-4o
# AI_MODEL=

# Set the key for whichever provider you selected above.

# AI_PROVIDER=openrouter — free tier, get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AI_PROVIDER=huggingface — Bielik is billed to your HF credits at $0.40/M
# tokens ($0.10/month free, $2.00/month on PRO). https://huggingface.co/settings/tokens
HF_TOKEN=

# AI_PROVIDER=openai — paid.
OPENAI_API_KEY=
